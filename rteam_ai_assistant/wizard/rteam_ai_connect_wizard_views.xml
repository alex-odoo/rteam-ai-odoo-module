<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rteam_ai_connect_wizard_form" model="ir.ui.view">
        <field name="name">rteam.ai.connect.wizard.form</field>
        <field name="model">rteam.ai.connect.wizard</field>
        <field name="arch" type="xml">
            <form string="Connect to Rteam AI">
                <field name="step" invisible="1"/>
                <field name="mode" invisible="1"/>

                <group invisible="step != 'form'">
                    <p class="text-muted" colspan="2">
                        This wizard creates a token that connects your Odoo instance
                        to the Rteam AI Telegram bot. The token is shown only once.
                        You can revoke it anytime from Settings → Rteam AI → Connections.
                    </p>
                    <field name="label"/>
                    <field name="scope"/>
                </group>

                <group invisible="step != 'result'" string="Your token is ready">
                    <p class="alert alert-warning" colspan="2" role="alert">
                        <strong>Copy this token now.</strong> For security reasons it
                        will never be shown again. If you lose it, rotate the connection
                        to issue a new one.
                    </p>
                    <field name="generated_token" readonly="1"/>
                    <field name="bot_deep_link" invisible="1"/>
                    <p colspan="2" class="text-center">
                        <button name="action_open_bot" type="object"
                                string="Open @RteamAI_bot on Telegram"
                                class="btn-primary btn-lg"/>
                    </p>
                    <p class="text-muted" colspan="2">
                        In Telegram: send <code>/connect</code> and paste the token when prompted,
                        or use the button above to start the bot with the token pre-filled.
                    </p>
                </group>

                <footer>
                    <button name="action_generate" type="object" string="Generate Token"
                            class="btn-primary" invisible="step == 'result'"/>
                    <button name="action_close" type="object" string="Done"
                            class="btn-primary" invisible="step != 'result'"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
