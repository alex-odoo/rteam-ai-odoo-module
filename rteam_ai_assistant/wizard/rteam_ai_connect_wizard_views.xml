<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rteam_ai_connect_wizard_form" model="ir.ui.view">
        <field name="name">rteam.ai.connect.wizard.form</field>
        <field name="model">rteam.ai.connect.wizard</field>
        <field name="arch" type="xml">
            <form string="Connect to Rteam AI">
                <field name="step" invisible="1"/>
                <field name="mode" invisible="1"/>
                <field name="label" invisible="1"/>

                <group invisible="step != 'form'" col="1">
                    <div class="text-center" style="padding: 16px 0;">
                        <h2 style="margin: 0;">Chat with your Odoo in Telegram</h2>
                        <p class="text-muted" style="margin-top: 8px;">
                            We'll create a scoped API key and hand it to
                            <strong>@RteamAI_bot</strong>. Takes one click —
                            revoke anytime.
                        </p>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="mode != 'new'">
                        <strong>Read only</strong> — the assistant answers questions but
                        cannot modify any records. You can upgrade to read &amp; write
                        later from the dashboard.
                    </div>
                    <group invisible="mode != 'rotate'">
                        <field name="scope"/>
                    </group>
                </group>

                <group invisible="step != 'result'" col="1">
                    <div class="text-center" style="padding: 16px 0;">
                        <h2 style="margin: 0;">You're ready.</h2>
                        <p class="text-muted" style="margin-top: 8px;">
                            Tap the button below to open Telegram. The token is already
                            linked to your account — no copy-paste needed.
                        </p>
                    </div>
                    <div class="text-center">
                        <button name="action_open_bot" type="object"
                                string="Open @RteamAI_bot on Telegram"
                                class="btn-primary btn-lg"/>
                    </div>
                    <field name="bot_deep_link" invisible="1"/>
                    <div class="alert alert-secondary" role="alert" style="margin-top: 16px;">
                        <strong>Token (one-time view):</strong>
                        <field name="generated_token" readonly="1" nolabel="1"/>
                        <p class="text-muted" style="margin: 6px 0 0 0; font-size: 12px;">
                            You normally don't need this — the deep link carries it.
                            Save it only if you want to connect manually via /connect.
                        </p>
                    </div>
                </group>

                <footer>
                    <button name="action_generate" type="object"
                            string="Connect Telegram"
                            class="btn-primary btn-lg" invisible="step == 'result'"/>
                    <button name="action_close" type="object" string="Done"
                            class="btn-primary" invisible="step != 'result'"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"
                            invisible="step == 'result'"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
