<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rteam_ai_connection_dashboard" model="ir.ui.view">
        <field name="name">rteam.ai.connection.dashboard</field>
        <field name="model">rteam.ai.connection</field>
        <field name="arch" type="xml">
            <form string="Rteam AI" create="0" delete="0" edit="0">
                <sheet>
                    <div class="text-center" style="padding: 24px 0 12px 0;">
                        <h1 style="margin: 0;">
                            Connected to <field name="remote_organization_name" readonly="1" nolabel="1" class="oe_inline" placeholder="your Odoo"/>
                        </h1>
                        <p class="text-muted" style="margin-top: 8px;">
                            Open the Telegram bot and ask anything about your Odoo data.
                        </p>
                    </div>

                    <div class="text-center" style="padding: 12px 0 24px 0;">
                        <button name="action_open_bot" type="object"
                                string="Open @RteamAI_bot on Telegram"
                                class="btn-primary btn-lg"/>
                    </div>

                    <group>
                        <group string="Status">
                            <field name="state" widget="badge"
                                   decoration-success="state == 'active'"
                                   decoration-muted="state == 'revoked'"/>
                            <field name="scope"/>
                            <field name="last_used"/>
                        </group>
                        <group string="Usage">
                            <field name="quota_used_today"/>
                            <field name="quota_limit"/>
                        </group>
                    </group>

                    <div class="o_row" style="padding: 24px 0 8px 0; border-top: 1px solid #dee2e6;">
                        <h4 style="margin: 12px 0;">Manage this connection</h4>
                    </div>

                    <div style="display: flex; gap: 12px; align-items: flex-start; padding: 12px 0;">
                        <div style="flex: 0 0 160px;">
                            <button name="action_rotate" type="object"
                                    string="Rotate Token"
                                    class="btn btn-secondary"
                                    help="Generate a new token. The current one stops working immediately."
                                    attrs="{'invisible': [('state', '!=', 'active')]}"/>
                        </div>
                        <div class="text-muted" style="flex: 1; font-size: 13px;">
                            <i class="fa fa-info-circle" style="margin-right: 4px;"/>
                            Generate a new token and invalidate the current one.
                            Use this if the token leaked, if you want to change the
                            scope (read-only ↔ read &amp; write), or as periodic
                            security rotation. The @RteamAI_bot deep link refreshes —
                            send it to yourself again.
                        </div>
                    </div>

                    <div style="display: flex; gap: 12px; align-items: flex-start; padding: 12px 0;">
                        <div style="flex: 0 0 160px;">
                            <button name="action_revoke" type="object"
                                    string="Revoke Connection"
                                    confirm="Revoking will immediately disconnect the Telegram bot and cannot be undone. You can reconnect from scratch via Rteam AI → Connect Telegram. Continue?"
                                    class="btn btn-danger"
                                    help="Permanently disconnect. The bot stops answering, the token is destroyed."
                                    attrs="{'invisible': [('state', '=', 'revoked')]}"/>
                        </div>
                        <div class="text-muted" style="flex: 1; font-size: 13px;">
                            <i class="fa fa-exclamation-triangle" style="margin-right: 4px; color: #dc3545;"/>
                            Permanently disconnect this Odoo from the Telegram
                            assistant. The token is destroyed, the bot stops
                            answering, and this record is locked in Revoked state.
                            You can always start fresh with <strong>Rteam AI →
                            Connect Telegram</strong>. The Odoo API key we created
                            is left in your profile — delete it from My Profile →
                            Account Security if you want a full cleanup.
                        </div>
                    </div>

                    <notebook groups="base.group_no_one">
                        <page string="Debug" name="debug">
                            <group>
                                <group>
                                    <field name="name"/>
                                    <field name="user_id"/>
                                    <field name="token_last4"/>
                                </group>
                                <group>
                                    <field name="api_endpoint" readonly="1"/>
                                    <field name="remote_connection_id" readonly="1"/>
                                    <field name="create_date" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rteam_ai_home" model="ir.actions.server">
        <field name="name">Rteam AI</field>
        <field name="model_id" ref="model_rteam_ai_connection"/>
        <field name="state">code</field>
        <field name="code">action = model.action_home()</field>
    </record>

</odoo>
